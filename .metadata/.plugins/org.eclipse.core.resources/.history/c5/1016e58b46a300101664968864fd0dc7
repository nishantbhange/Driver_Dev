#include"stm32f40xx_spi_driver.h"


void Spi_Periph_Clk_Control(Spi_Reg_Def *Pspix,uint8_t EnorDI){
	if (EnorDI==Enable){

			if (Pspix==SPI1){
				SPI1_PCLK_EN();
			    }
			else if(Pspix==SPI2){
				SPI2_PCLK_EN();
				}
			else if(Pspix==SPI3){
				SPI3_PCLK_EN();
				}
		}

		else{

			if (Pspix==SPI1){
				SPI1_PCLK_DI();
				}
			else if(Pspix==SPI2){
				SPI2_PCLK_DI();
				}
			else if(Pspix==SPI3){
				SPI3_PCLK_DI();
				}


		}


}
void Spi_Init(Spi_Handle_t *Pspix_Handle){
	uint32_t tempreg=0;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Device_Mode<<2;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Cpol<<1;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Cpha<<0;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Ssm<<9;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Dff<<11;
	tempreg |=*Pspix_Handle->Spi_Config.Spi_Sclk_Speed<<5;
	if(*Pspix_Handle->Spi_Config.Spi_Bus_Config==SPI_FULL_DUPLEX){

		tempreg|=(1<<15);
	}
	if(*Pspix_Handle->Spi_Config.Spi_Device_Mode==SPI_HALF_DUPLEX){
		tempreg &=~(1<<15);
	}

	if(*Pspix_Handle->Spi_Config.Spi_Device_Mode==SPI_SIMPLEX_RX){
			tempreg &=~(1<<14);
			tempreg |=(1<<10);
		}

}
