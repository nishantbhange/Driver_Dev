#include"stm32f40xx_spi_driver.h"


void Spi_Periph_Clk_Control(Spi_Reg_Def *Pspix,uint8_t EnorDI){
	if (EnorDI==Enable){

			if (Pspix==SPI1){
				SPI1_PCLK_EN();
			    }
			else if(Pspix==SPI2){
				SPI2_PCLK_EN();
				}
			else if(Pspix==SPI3){
				SPI3_PCLK_EN();
				}
		}

		else{

			if (Pspix==SPI1){
				SPI1_PCLK_DI();
				}
			else if(Pspix==SPI2){
				SPI2_PCLK_DI();
				}
			else if(Pspix==SPI3){
				SPI3_PCLK_DI();
				}


		}


}
