void Spi_Send_Data(Spi_Reg_Def *Pspix,uint8_t *pTXbuffer,uint32_t length){

	while(length>0){

		while(!((Pspix->SPI_SR>>1)&0x01)){}
		if(!((Pspix->SPI_CR1>>11)&0x01)){
			Pspix->SPI_DR=*pTXbuffer;
			length--;
			pTXbuffer++;
			}
		else{
			Pspix->SPI_DR=*((uint16_t*)pTXbuffer);
			length--;
			length--;
			pTXbuffer++;
			pTXbuffer++;
		}

		}

}
void Spi_Recieve_Data(Spi_Reg_Def *Pspix,uint8_t *pRXbuffer,uint32_t length){
	while(length>0){

			while(((Pspix->SPI_SR)&0x01));
			if(!((Pspix->SPI_CR1>>11)&0x01)){
				*pRXbuffer=Pspix->SPI_DR;
				length--;
				pRXbuffer++;
				}
			else{
				*((uint16_t*)pRXbuffer)=Pspix->SPI_DR;
				length--;
				length--;
				pRXbuffer++;
				pRXbuffer++;
			}

			}

}

